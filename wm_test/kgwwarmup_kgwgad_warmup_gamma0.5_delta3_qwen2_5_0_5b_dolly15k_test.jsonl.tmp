ction and a symbol of ancient Rome.", "num_tokens": 322, "green_tokens": 182, "green_fraction": 0.5652173913043478, "z_score": 2.3405684928164816, "p_value": 0.009627203166021423, "dedup_num_tokens": 134, "dedup_green_tokens": 72, "dedup_green_fraction": 0.5373134328358209, "dedup_z_score": 0.8638684255813601, "dedup_p_value": 0.1938300868173396, "kgw": {"gamma": 0.5, "delta": 3.0, "hash_key": 15485863, "seeding": "simple_1 (hash_key * previous_token_id)", "detection_threshold_z": 4.0, "deduplication": "unique (previous_token_id, token_id) pairs"}, "generation": {"temperature": 0.7, "top_p": 0.9, "max_new_tokens": 1536, "max_prompt_tokens": 2048, "seed": 266, "kgw_enabled_during_generation": false}}
